{
    "name": "Delta",
    "version": "1.0.0",
    "role": "Sentiment Analysis Specialist",
    "description": "Analyzes news sentiment, market narratives, and retail trends. Focuses on sentiment scoring, trend detection, and market 'vibe' interpretation.",
    "capabilities": [
        "News sentiment analysis and scoring",
        "Market narrative and theme identification",
        "Trend detection and momentum analysis",
        "Retail investor sentiment assessment",
        "Media coverage pattern analysis",
        "Risk persona adaptation (Zen/Alpha)"
    ],
    "mcp_tools_required": [
        "get_news_stream"
    ],
    "input_schema": {
        "type": "object",
        "properties": {
            "ticker": {
                "type": "string",
                "description": "Stock ticker symbol (e.g., 'AAPL', 'MSFT')",
                "pattern": "^[A-Z]{1,5}$"
            },
            "days": {
                "type": "integer",
                "description": "Number of days to look back for news",
                "default": 7,
                "minimum": 1,
                "maximum": 30
            },
            "max_articles": {
                "type": "integer",
                "description": "Maximum number of articles to analyze",
                "default": 15,
                "minimum": 5,
                "maximum": 50
            },
            "persona": {
                "type": "string",
                "description": "Risk persona for analysis perspective",
                "enum": [
                    "zen",
                    "alpha",
                    "balanced"
                ],
                "default": "balanced"
            }
        },
        "required": [
            "ticker"
        ]
    },
    "output_schema": {
        "type": "object",
        "properties": {
            "agent": {
                "type": "string",
                "const": "Delta"
            },
            "ticker": {
                "type": "string"
            },
            "persona": {
                "type": "string"
            },
            "news_analyzed": {
                "type": "object",
                "properties": {
                    "article_count": {
                        "type": "integer"
                    },
                    "time_range": {
                        "type": "string"
                    },
                    "sources": {
                        "type": "array",
                        "items": {
                            "type": "string"
                        }
                    }
                }
            },
            "analysis": {
                "type": "string",
                "description": "Comprehensive sentiment analysis"
            },
            "sentiment": {
                "type": "string",
                "enum": [
                    "Positive",
                    "Neutral",
                    "Negative"
                ]
            },
            "confidence": {
                "type": "number",
                "minimum": 0,
                "maximum": 100
            }
        }
    },
    "persona_profiles": {
        "zen": {
            "focus": "Risk-aware sentiment analysis",
            "priorities": [
                "Negative sentiment signals",
                "Risk indicators in news",
                "Caution flags and warnings",
                "Downside narrative detection",
                "Stability and predictability themes"
            ]
        },
        "alpha": {
            "focus": "Growth-oriented sentiment analysis",
            "priorities": [
                "Positive momentum signals",
                "Growth narratives",
                "Innovation and disruption themes",
                "Upside catalysts in news",
                "Market excitement and hype"
            ]
        },
        "balanced": {
            "focus": "Consensus-based sentiment analysis",
            "priorities": [
                "Mainstream narrative confirmation",
                "Institutional sentiment shifts",
                "Balanced news coverage",
                "Major thematic trends",
                "Event-driven sentiment spikes"
            ]
        }
    },
    "model": "gemini-2.0-flash-exp",
    "author": "Kai - Economist Team",
    "tags": [
        "sentiment-analysis",
        "news-analysis",
        "market-narrative",
        "trend-detection"
    ]
}